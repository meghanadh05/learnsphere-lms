MYSQL_DATABASE=learnsphere
MYSQL_USER=learnsphere
MYSQL_PASSWORD=replace_with_a_strong_password
MYSQL_ROOT_PASSWORD=replace_with_another_strong_password
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRATION_MS=86400000
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

